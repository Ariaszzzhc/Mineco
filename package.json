{
  "name": "mineco",
  "private": true,
  "version": "0.4.0",
  "description": "A minimal Electron + Svelte desktop agent host for the Claude Agent SDK.",
  "author": "Ariaszzzhc <ariaszzzzhc@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^1.0.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.177",
    "@lucide/svelte": "^1.20.0",
    "@tailwindcss/vite": "^4.3.1",
    "bits-ui": "^2.18.1",
    "dompurify": "^3.4.10",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "marked-highlight": "^2.2.4",
    "tailwindcss": "^4.3.1"
  }
}
